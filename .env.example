# =============================================================================
# AI CHARTERED ACCOUNTANT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your API keys
# See EXTERNAL_SERVICES.md for service links and pricing details

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================
# Provider preference order (comma-separated)
LLM_PROVIDER_PREFERENCE=google_genai,groq,ollama,openrouter,openai,huggingface

# Primary LLM APIs (set at least one)
GOOGLE_API_KEY=                    # https://makersuite.google.com/app/apikey
GROQ_API_KEY=                      # https://console.groq.com/keys
OPENAI_API_KEY=                    # https://platform.openai.com/api-keys

# Fallback LLM APIs
OPENROUTER_API_KEY=                # https://openrouter.ai/keys
OPENROUTER_ENABLED=true
HUGGINGFACEHUB_API_TOKEN=          # https://huggingface.co/settings/tokens

# Local LLM (Ollama)
OLLAMA_ENABLED=true
OLLAMA_MODEL=dolphin-llama3

# =============================================================================
# EMBEDDINGS & RAG (auto mode uses free options first)
# =============================================================================
EMBEDDING_PROVIDER=auto            # auto, jina, sentence-transformers, voyage, cohere, openai, bedrock
EMBEDDING_MODEL=all-mpnet-base-v2  # Local model (768-dim)

# FREE Cloud Embeddings (recommended)
JINA_API_KEY=                      # https://jina.ai/ (1M tokens/month FREE, 1024-dim)

# Paid Cloud Embeddings (optional)
# VOYAGE_API_KEY=                  # https://www.voyageai.com/ (50M free for new accounts)
# COHERE_API_KEY=                  # https://cohere.com/ (trial credits)
# AWS_BEDROCK_REGION=us-east-1     # For AWS Bedrock Titan embeddings

# =============================================================================
# RE-RANKING (auto mode uses free options first)
# =============================================================================
# Uses JINA_API_KEY for FREE reranking if set
# Falls back to local Cross-Encoder if no API key

# Paid Reranking (optional)
# COHERE_RERANK_MODEL=rerank-v3.5

# Local Reranking Model
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# =============================================================================
# VECTOR DATABASE
# ===================              # 'qdrant' or 'chroma'

# Qdrant Cloud (Recommended for production)
VECTOR_DB_QDRANT_HOST=             # https://your-cluster.cloud.qdrant.io
VECTOR_DB_QDRANT_API_KEY=          # API key from Qdrant dashboard
QDRANT_COLLECTION=AI-CA-768        # Collection name
QDRANT_VECTOR_SIZE=768             # Must match embedding model dimensions

# ChromaDB Local (Alternative - for development)
# VECTOR_DB_T (for L2 cache layer and distributed caching)
# =============================================================================
# Upstash Redis (Cloud - Recommended, 10k commands/day FREE)
REDIS_URL=                         # https://your-redis.upstash.io (or rediss:// for TLS)
REDIS_TOKEN=                       # Token for Upstash HTTPS endpoints
CACHE_TTL_SECONDS=3600             # Default TTL for cached entries (1 hour)

# AWS ElastiCache (Alternative - for AWS deployments)
# REDIS_URL=redis://your-cluster.cache.amazonaws.com:6379

# Local Redis (Alternative - for development)
# REDIS_URL=redis://localhost:6379=========================================================
# Upstash Redis (Cloud)
REDIS_URL=                         # https://upstas - NEW!)
# =============================================================================
# 3-tier architecture: L1 (memory, 0.01ms) → L2 (Redis, 1-5ms) → L3 (semantic, 10-50ms)
# Provides 850-1,192,000x speedup on cache hits with semantic query matching
# Example: "Revenue in FY23" ≈ "FY23 revenue" → same cache entry

HOT_CACHE_MAX_ENTRIES=1000         # L1 in-memory max entries per worker
HOT_CACHE_TTL_SECONDS=1800         # Default TTL: 30 minutes (adjust based on data freshness needs)

# L3 Semantic Similarity Caching
HOT_CACHE_SEMANTIC=true            # Enable embedding-based semantic matching
HOT_CACHE_SIMILARITY=0.92          # Similarity threshold (0.85-0.95 recommended)
                                   # Lower = more matches but less precision
# Local Sandbox (Built-in - restricted Python execution)
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_ALLOWED_MODULES=["pandas","numpy","math","json","re","datetime","statistics","decimal"]
SANDBOX_TEMP_DIR=./data/tmp

# E2B Remote Sandbox (Optional - recommended for production, 100 hrs/month FREE)
ENABLE_E2B=false
E2B_API_KEY=                       # https://e2b.dev/
E2B_TIMEOUT_SECONDS=30             # Timeout for remote code execution: Semantic embeddings (optional)
HOT_CACHE_MAX_ENTRIES=1000         # L1 in-memory max entries
HOT_CACHE_TTL_SECONDS=1800         # 30 min default TTL
HOT_CACHE_SEMANTIC=true            # Enable L3 embedding-based semantic similarity
HOT_CACHE_SIMILARITY=0.92          # Similarity threshold for L3 matching (0.0-1.0)
HOT_CACHE_EMBEDDING_PROVIDER=auto  # auto (tries jina→local), jina, sentence-transformers
KV_CACHE_MAX_MB=2048               # KV state cache max memory (local LLMs only)

# ==================================================-64-CHARS-MIN
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440        # 24 hours
API_KEY_HEADER=x-api-key
ENFORCE_TENANT_FILTERING=true

# Rate Limitin & UPLOADS
# =============================================================================
FILE_STORE_PATH=./data/uploads           # Local file uploads directory
DOCUMENT_STORE_PATH=./data/documents     # Document ingestion directory
MAX_UPLOAD_SIZE_MB=50                    # Max file upload size
ALLOWED_FILE_TYPES=["pdf","docx","xlsx","csv","xls","txt","json"]

# File Processing
EXCEL_MAX_SHEETS=50                      # Max sheets to process per Excel file
EXCEL_MAX_ROWS_PER_SHEET=1000000        # Max rows per sheet (1M default)
PDF_MAX_PAGES=500                        # Max pages to extract from PDF
# API_KEYS=["key1","key2","key3"]  # Comma-separated API keys for client authentication
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_ALLOWED_MODULES=["pandas","numpy","math","json","re","datetime"]
SANDBOX_TEMP_DIR=./data/tmp

# E2B Remote Sandbox (optional, recommended for production)
ENABLE_E2B=false
E2B_API_KEY=                       # https://e2b.dev/

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING
JWT_ALGORITHM=HS256
API_KEY_HEADER=x-api-key
ENFORCE_TENANT_FILTERING=true

# =============================================================================
# FILE STORAGE
# =============================================================================
FILE_STORE_PATH=./data/uploads
DOCUMENT_STORE_PATH=./data/documents
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=["pdf","docx","xlsx","csv"]

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_WORKERS=4

# CORS
ENABLE_CORS=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ENABLE_SWAGGER=true

# =============================================================================
# LOGGING & OBSERVABILITY
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json                    # 'json' or 'text'

# Sentry Error Tracking (Optional)
SENTRY_DSN=                        # https://sentry.io/ (5k events/month free)
SENTRY_ENVIRONMENT=development     # development, staging, production
SENTRY_TRACES_SAMPLE_RATE=0.1     # 10% of transactions for performance monitoring

# OpenObserve Logging (Optional - Self-hosted alternative)
# OPENOBSERVE_URL=http://localhost:5080
# OPENOBSERVE_AUTH_KEY=your-auth-key
# OPENOBSERVE_ORGANIZATION=default
# OPENOBSERVE_STREAM=ai-ca-logs

# Log Retention (days)
LOG_HIGH_VALUE_RETENTION_DAYS=365
LOG_MEDIUM_VALUE_RETENTION_DAYS=14
LOG_LOW_VALUE_RETENTION_HOURS=72

# CloudWatch Logs (AWS only - auto-configured in ECS/EKS)
# CLOUDWATCH_LOG_GROUP=/ecs/valuenaire-task
# CLOUDWATCH_LOG_STREAM_PREFIX=ecs

# =============================================================================
# AWS DEPLOYMENT (Production Only)
# =============================================================================
# See AWS_SERVICES_SETUP_GUIDE.md for complete setup instructions

# Deployment Mode
DEPLOYMENT_ENV=local               # 'local' or 'aws' (triggers S3 backend auto-switch)

# ADVANCED CONFIGURATION
# =============================================================================
# ZeroMQ (for inter-process communication)
ZMQ_IPC_ENDPOINT=ipc:///tmp/ai_ca.sock
ZMQ_TIMEOUT_MS=5000

# Prompt Management
PROMPTS_DIR=./prompts
PROMPTS_WATCH_RELOAD=true          # Auto-reload prompts on file changes

# Agent Configuration
AGENT_MAX_ITERATIONS=10            # Max reasoning steps for agents
AGENT_TIMEOUT_SECONDS=120          # Timeout for agent execution
ENABLE_AGENT_STREAMING=true        # Stream agent reasoning steps to client

# Query Processing
MAX_CONTEXT_LENGTH=8000            # Max tokens for RAG context
TOP_K_RETRIEVAL=5                  # Number of documents to retrieve from vector DB
RERANK_TOP_K=3                     # Number of documents after reranking

# =============================================================================
# CONTAINER DEPLOYMENT (ECS/EKS specific)
# =============================================================================
# These are typically set by container orchestration platforms

# ECS Task Metadata
# ECS_CONTAINER_METADATA_URI_V4=http://169.254.170.2/v4
# AWS_EXECUTION_ENV=AWS_ECS_FARGATE

# Kubernetes Environment
# KUBERNETES_SERVICE_HOST=10.0.0.1
# KUBERNETES_SERVICE_PORT=443

# Health Check Endpoints (used by ALB/load balancers)
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready          # AKIA... (from IAM user)
AWS_SECRET_ACCESS_KEY=             # Secret key (from IAM user - keep secure!)

# AWS S3 Advanced Settings
DEPLOYMENT_AWS_S3_PREFIX=dataframes/   # S3 key prefix for organization
S3_LOG_BUCKET=                         # Optional: separate bucket for logs
S3_LOG_PREFIX=logs/ai-ca              # Log prefix in S3

# AWS ElastiCache Redis (Optional - for multi-instance deployments)
# REDIS_URL=redis://your-cluster.cache.amazonaws.com:6379
# Or continue using Upstash (already configured above)

# Storage Settings
STORAGE_PARQUET_COMPRESSION=snappy
STORAGE_MAX_DATAFRAME_SIZE_MB=500
STORAGE_MAX_LRU_DATAFRAMES=10
DEPLOYMENT_ENABLE_LOCAL_CACHE=true
DEPLOYMENT_TEMP_DIR=/tmp/ai_ca

# =============================================================================
# MISC
# =============================================================================
ZMQ_IPC_ENDPOINT=ipc:///tmp/ai_ca.sock
ZMQ_TIMEOUT_MS=5000
PROMPTS_DIR=./prompts
PROMPTS_WATCH_RELOAD=true
