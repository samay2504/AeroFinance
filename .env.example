# =============================================================================
# AI CHARTERED ACCOUNTANT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your API keys
# See EXTERNAL_SERVICES.md for service links and pricing details

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================
# Provider preference order (comma-separated)
LLM_PROVIDER_PREFERENCE=google_genai,groq,ollama,openrouter,openai,huggingface

# Primary LLM APIs (set at least one)
GOOGLE_API_KEY=                    # https://makersuite.google.com/app/apikey
GROQ_API_KEY=                      # https://console.groq.com/keys
OPENAI_API_KEY=                    # https://platform.openai.com/api-keys

# Fallback LLM APIs
OPENROUTER_API_KEY=                # https://openrouter.ai/keys
OPENROUTER_ENABLED=true
HUGGINGFACEHUB_API_TOKEN=          # https://huggingface.co/settings/tokens

# Local LLM (Ollama)
OLLAMA_ENABLED=true
OLLAMA_MODEL=dolphin-llama3

# =============================================================================
# EMBEDDINGS & RAG (auto mode uses free options first)
# =============================================================================
EMBEDDING_PROVIDER=auto            # auto, jina, sentence-transformers, voyage, cohere, openai, bedrock
EMBEDDING_MODEL=all-mpnet-base-v2  # Local model (768-dim)

# FREE Cloud Embeddings (recommended)
JINA_API_KEY=                      # https://jina.ai/ (1M tokens/month FREE, 1024-dim)

# Paid Cloud Embeddings (optional)
# VOYAGE_API_KEY=                  # https://www.voyageai.com/ (50M free for new accounts)
# COHERE_API_KEY=                  # https://cohere.com/ (trial credits)
# AWS_BEDROCK_REGION=us-east-1     # For AWS Bedrock Titan embeddings

# =============================================================================
# RE-RANKING (auto mode uses free options first)
# =============================================================================
# Uses JINA_API_KEY for FREE reranking if set
# Falls back to local Cross-Encoder if no API key

# Paid Reranking (optional)
# COHERE_RERANK_MODEL=rerank-v3.5

# Local Reranking Model
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# =============================================================================
# VECTOR DATABASE
# ===================              # 'qdrant' or 'chroma'

# Qdrant Cloud (Recommended for production)
VECTOR_DB_QDRANT_HOST=             # https://your-cluster.cloud.qdrant.io
VECTOR_DB_QDRANT_API_KEY=          # API key from Qdrant dashboard
QDRANT_COLLECTION=AI-CA-768        # Collection name
QDRANT_VECTOR_SIZE=768             # Must match embedding model dimensions

# ChromaDB Local (Alternative - for development)
# VECTOR_DB_T (for L2 cache layer and distributed caching)
# =============================================================================
# =============================================================================
# REDIS / VALKEY CACHE  (L2 distributed cache — optional, graceful fallback)
# =============================================================================
# redis_client.py resolves URLs in this order (first non-empty wins):
#   REDIS_URL → CACHE_REDIS_URL → UPSTASH_REDIS_URL
#   → VALKEY_URL → VALKEY_CLOUD_URL → KV_URL
#
# ── Option 1: Upstash (Cloud Redis — 10k commands/day FREE) ─────────────────
# IMPORTANT: use rediss:// (TLS), NOT the https:// REST endpoint
# Format: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=                         # rediss://default:TOKEN@host.upstash.io:6379
REDIS_TOKEN=                       # Upstash token (used as Redis password above)
#
# ── Option 2: AWS ElastiCache Redis ──────────────────────────────────────────
# REDIS_URL=redis://your-cluster.cfg.use1.cache.amazonaws.com:6379
#
# ── Option 3: AWS ElastiCache Valkey (NEW — fully API-compatible) ────────────
# redis_client.py auto-converts valkey[s]:// → redis[s]:// for redis-py
# VALKEY_URL=valkey://your-valkey-cluster.cache.amazonaws.com:6379
# VALKEY_URL=valkeys://your-valkey-cluster.cache.amazonaws.com:6379   # TLS
#
# ── Option 4: Valkey Cloud / Valkey OSS ──────────────────────────────────────
# VALKEY_CLOUD_URL=valkey://cloud.valkey.io:6379
#
# ── Option 5: Vercel KV / Railway Redis ──────────────────────────────────────
# KV_URL=redis://...
#
# ── Option 6: Docker Valkey (sub-fallback — after all cloud options) ───────────────────
# Starts automatically with docker-compose.yml (valkey service on port 6380)
# Quick start (standalone):  docker run -d --name ai-ca-valkey -p 6380:6379 valkey/valkey:8-alpine
# VALKEY_DOCKER_URL=valkey://localhost:6380
VALKEY_PORT=6380                   # Host port for Docker Valkey container
VALKEY_MAX_MEMORY=256mb            # Valkey container memory limit
VALKEY_DOCKER_CONTAINER=valuenaire-valkey
#
# ── Option 7: Local Docker Redis (legacy development) ───────────────────────────────
# REDIS_URL=redis://localhost:6379
# REDIS_DOCKER_CONTAINER=ai-ca-redis

CACHE_TTL_SECONDS=3600             # Default TTL for cached entries (1 hour)

# =============================================================================
# HOT PROMPT CACHE (3-tier LLM response caching)
# =============================================================================
# Architecture: L1 (memory, 0.01ms) → L2 (Redis/Valkey, 1-5ms) → L3 (semantic, 10-50ms)
# All tiers gracefully degrade — works without Redis configured.

HOT_CACHE_MAX_ENTRIES=1000         # L1 in-memory max entries per worker
HOT_CACHE_TTL_SECONDS=1800         # Default TTL: 30 minutes
HOT_CACHE_SEMANTIC=true            # Enable L3 embedding-based semantic matching
HOT_CACHE_SIMILARITY=0.92          # Similarity threshold (0.85-0.95 recommended)
HOT_CACHE_EMBEDDING_PROVIDER=auto  # auto, jina, sentence-transformers
HOT_CACHE_HOT_KEY_THRESHOLD=10     # Hits before promotion to L1 (0ms local RAM cache)
HOT_CACHE_L1_TTL=60               # TTL for L1 promoted entries (seconds)
KV_CACHE_MAX_MB=2048               # KV state cache max memory (local LLMs only)

# =============================================================================
# CODE EXECUTION SANDBOX
# =============================================================================
# Local Sandbox (Built-in - restricted Python execution)
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_ALLOWED_MODULES=["pandas","numpy","math","json","re","datetime","statistics","decimal"]
SANDBOX_TEMP_DIR=./data/tmp

# E2B Remote Sandbox (Optional - recommended for production, 100 hrs/month FREE)
ENABLE_E2B=false
E2B_API_KEY=                       # https://e2b.dev/
E2B_TIMEOUT_SECONDS=30

# ==================================================-64-CHARS-MIN
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440        # 24 hours
API_KEY_HEADER=x-api-key
ENFORCE_TENANT_FILTERING=true

# Rate Limitin & UPLOADS
# =============================================================================
FILE_STORE_PATH=./data/uploads           # Local file uploads directory
DOCUMENT_STORE_PATH=./data/documents     # Document ingestion directory
MAX_UPLOAD_SIZE_MB=50                    # Max file upload size
ALLOWED_FILE_TYPES=["pdf","docx","xlsx","csv","xls","txt","json"]

# File Processing
EXCEL_MAX_SHEETS=50                      # Max sheets to process per Excel file
EXCEL_MAX_ROWS_PER_SHEET=1000000        # Max rows per sheet (1M default)
PDF_MAX_PAGES=500                        # Max pages to extract from PDF
# API_KEYS=["key1","key2","key3"]  # Comma-separated API keys for client authentication
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_ALLOWED_MODULES=["pandas","numpy","math","json","re","datetime"]
SANDBOX_TEMP_DIR=./data/tmp

# E2B Remote Sandbox (optional, recommended for production)
ENABLE_E2B=false
E2B_API_KEY=                       # https://e2b.dev/

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING
JWT_ALGORITHM=HS256
API_KEY_HEADER=x-api-key
ENFORCE_TENANT_FILTERING=true

# =============================================================================
# FILE STORAGE
# =============================================================================
FILE_STORE_PATH=./data/uploads
DOCUMENT_STORE_PATH=./data/documents
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=["pdf","docx","xlsx","csv"]

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_WORKERS=4

# CORS
ENABLE_CORS=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ENABLE_SWAGGER=true

# =============================================================================
# LOGGING & OBSERVABILITY
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json                    # 'json' or 'text'

# Sentry Error Tracking (Optional)
SENTRY_DSN=                        # https://sentry.io/ (5k events/month free)
SENTRY_ENVIRONMENT=development     # development, staging, production
SENTRY_TRACES_SAMPLE_RATE=0.1     # 10% of transactions for performance monitoring

# OpenObserve Logging (Optional - Self-hosted alternative)
# OPENOBSERVE_URL=http://localhost:5080
# OPENOBSERVE_AUTH_KEY=your-auth-key
# OPENOBSERVE_ORGANIZATION=default
# OPENOBSERVE_STREAM=ai-ca-logs

# Log Retention (days)
LOG_HIGH_VALUE_RETENTION_DAYS=365
LOG_MEDIUM_VALUE_RETENTION_DAYS=14
LOG_LOW_VALUE_RETENTION_HOURS=72

# CloudWatch Logs (AWS only - auto-configured in ECS/EKS)
# CLOUDWATCH_LOG_GROUP=/ecs/valuenaire-task
# CLOUDWATCH_LOG_STREAM_PREFIX=ecs

# =============================================================================
# AWS DEPLOYMENT (Production Only)
# =============================================================================
# See AWS_SERVICES_SETUP_GUIDE.md for complete setup instructions

# Deployment Mode
DEPLOYMENT_ENV=local               # 'local' or 'aws' (triggers S3 backend auto-switch)
AWS_DEFAULT_REGION=ap-south-1

# S3 Storage (for DEPLOYMENT_ENV=aws)
DEPLOYMENT_AWS_S3_BUCKET=
DEPLOYMENT_AWS_S3_PREFIX=dataframes/
S3_LOG_BUCKET=
S3_LOG_PREFIX=logs/ai-ca

# AWS Credentials (use IAM roles in production)
# AWS_ACCESS_KEY_ID=                 # AKIA... (from IAM user)
# AWS_SECRET_ACCESS_KEY=             # Secret key (from IAM user - keep secure!)

# AWS ElastiCache Redis (Optional - for multi-instance deployments)
# REDIS_URL=redis://your-cluster.cache.amazonaws.com:6379
# Or continue using Upstash (already configured above)

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# ZeroMQ (for inter-process communication)
ZMQ_IPC_ENDPOINT=ipc:///tmp/ai_ca.sock
ZMQ_TIMEOUT_MS=5000

# Prompt Management
PROMPTS_DIR=./prompts
PROMPTS_WATCH_RELOAD=true          # Auto-reload prompts on file changes

# Agent Configuration
AGENT_MAX_ITERATIONS=10            # Max reasoning steps for agents
AGENT_TIMEOUT_SECONDS=120          # Timeout for agent execution
ENABLE_AGENT_STREAMING=true        # Stream agent reasoning steps to client

# Query Processing
MAX_CONTEXT_LENGTH=8000            # Max tokens for RAG context
TOP_K_RETRIEVAL=5                  # Number of documents to retrieve from vector DB
RERANK_TOP_K=3                     # Number of documents after reranking

# =============================================================================
# CONTAINER DEPLOYMENT (ECS/EKS specific)
# =============================================================================
# These are typically set by container orchestration platforms

# ECS Task Metadata
# ECS_CONTAINER_METADATA_URI_V4=http://169.254.170.2/v4
# AWS_EXECUTION_ENV=AWS_ECS_FARGATE

# Kubernetes Environment
# KUBERNETES_SERVICE_HOST=10.0.0.1
# KUBERNETES_SERVICE_PORT=443

# Health Check Endpoints (used by ALB/load balancers)
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready

# AWS ElastiCache Redis (Optional - for multi-instance deployments)
# REDIS_URL=redis://your-cluster.cache.amazonaws.com:6379
# Or continue using Upstash (already configured above)

# Storage Settings
STORAGE_PARQUET_COMPRESSION=snappy
STORAGE_MAX_DATAFRAME_SIZE_MB=500
STORAGE_MAX_LRU_DATAFRAMES=10
STORAGE_FILE_STORE_PATH=./data/uploads
STORAGE_DATAFRAME_CACHE_PATH=./data/dataframe_cache
STORAGE_BLOOM_CAPACITY=10000       # Estimated dataset count for Bloom filter
STORAGE_BLOOM_FP_RATE=0.01         # False positive rate (1%) for existence check
DEPLOYMENT_ENABLE_LOCAL_CACHE=true
DEPLOYMENT_TEMP_DIR=/tmp/ai_ca

# =============================================================================
# MISC
# =============================================================================
ZMQ_IPC_ENDPOINT=ipc:///tmp/ai_ca.sock
ZMQ_TIMEOUT_MS=5000
PROMPTS_DIR=./prompts
PROMPTS_WATCH_RELOAD=true
FASTAPI_SINGLE_FLIGHT_TIMEOUT=120.0        # Max wait for coalesced requests

# =============================================================================
# PDF INGESTION & VISION PIPELINE (PDFSettings — env_prefix: PDF_)
# =============================================================================
# Google Cloud Vision API (Primary Vision — 1,000 units/month free)
GOOGLE_APPLICATION_CREDENTIALS=            # /path/to/service-account.json
# GOOGLE_API_KEY=                          # Already set above for Gemini

# Core Settings
PDF_ENABLE_VISION=true                     # Enable vision cascade for scanned/image PDFs
PDF_VISION_THRESHOLD=50                    # Min chars extracted for text-path; below → vision cascade
PDF_MAX_CHUNK_TOKENS=1024                  # Max tokens per semantic chunk
PDF_PARALLEL_WORKERS=4                     # ProcessPoolExecutor workers
PDF_CACHE_DIR=./data/pdf_cache             # Disk cache for fingerprints, chunks, vision

# Google Vision + Gemini (L1 of vision cascade)
# Get your free API key: https://aistudio.google.com/apikey
PDF_VISION_MODEL=gemini-2.0-flash          # Free tier: 15 RPM, 1M context, multimodal
PDF_VISION_EMBEDDING_MODEL=models/text-embedding-004
# PDF_GOOGLE_CREDENTIALS_PATH=             # GCP service-account JSON (optional — uses GOOGLE_API_KEY or ADC if unset)

# Self-Hosted VLM OCR (Optional — L2 of vision cascade)
# Auto-manages a Docker container with GPU-aware OOM protection.
# Default model is Qwen2.5-VL-3B: ungated, free, no HF token needed.
# Alternative: rednote-hilab/dots.ocr-1.5 (gated — needs HF_TOKEN + license accept on HuggingFace)
# Requirements: CUDA GPU (≥4 GB VRAM), Docker Desktop
PDF_DOTS_OCR_ENABLED=false
# PDF_DOTS_OCR_ENDPOINT=http://your-host:5555  # Required when ENABLED=true (or set AUTO_DOCKER=true)
PDF_DOTS_OCR_TIMEOUT=30                    # HTTP request timeout in seconds
PDF_DOTS_OCR_MIN_CONFIDENCE=0.6            # Minimum confidence to accept
PDF_DOTS_OCR_AUTO_DOCKER=false             # Auto-pull and manage Docker container (detects GPU VRAM, avoids OOM)
PDF_DOTS_OCR_DOCKER_IMAGE=vllm/vllm-openai:latest
PDF_DOTS_OCR_MODEL=Qwen/Qwen2.5-VL-3B-Instruct  # Ungated default. Alt: rednote-hilab/dots.ocr-1.5 (needs HF_TOKEN)

# Lazy Embedding
PDF_EMBEDDING_BATCH_SIZE=16                # Batch size for embed on retrieval

# Retrieval Funnel
PDF_BM25_PREFILTER_K=500                   # BM25 pre-filter candidate count
PDF_VECTOR_CAP=50                          # Max candidates for vector similarity
PDF_ENABLE_RERANK=true                     # L4 reranking (Jina/Cohere/Cross-Encoder)
PDF_RERANK_MODEL=auto                      # auto, jina, cohere, cross_encoder, none
